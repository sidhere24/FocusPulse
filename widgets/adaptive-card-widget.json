{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "✦",
              "size": "Medium",
              "weight": "Bolder",
              "color": "Accent"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "FocusPulse",
              "weight": "Bolder",
              "size": "Medium"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Container",
              "style": "emphasis",
              "bleed": true,
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${status}",
                  "size": "Small",
                  "weight": "Bolder",
                  "color": "Good"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "default",
      "separator": true,
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "CURRENT APPLICATION",
          "size": "Small",
          "weight": "Bolder",
          "isSubtle": true
        },
        {
          "type": "TextBlock",
          "text": "${currentApp.name}",
          "size": "Large",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${currentApp.title}",
          "size": "Small",
          "isSubtle": true,
          "wrap": true
        },
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Session: ${currentApp.sessionTime}",
                  "weight": "Bolder",
                  "color": "Warning",
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${currentApp.state}",
                  "horizontalAlignment": "Right",
                  "weight": "Bolder",
                  "color": "Good",
                  "size": "Small"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "style": "emphasis",
          "items": [
            {
              "type": "TextBlock",
              "text": "ACTIVE TODAY",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${summary.activeTime}",
              "size": "ExtraLarge",
              "weight": "Bolder",
              "color": "Good"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "style": "emphasis",
          "items": [
            {
              "type": "TextBlock",
              "text": "FOCUS WORK",
              "size": "Small",
              "isSubtle": true,
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${summary.focusTime}",
              "size": "ExtraLarge",
              "weight": "Bolder",
              "color": "Accent"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "TOP APPLICATIONS TODAY",
          "size": "Small",
          "weight": "Bolder",
          "isSubtle": true
        },
        {
          "type": "FactSet",
          "$data": "${topApps}",
          "facts": [
            {
              "title": "${name}",
              "value": "${duration} (${percent}%)"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Start 25m Sprint",
      "verb": "startSprint"
    },
    {
      "type": "Action.Execute",
      "title": "Refresh",
      "verb": "refreshStats"
    }
  ]
}
